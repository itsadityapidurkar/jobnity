# Jobnity Backend Configuration
PROJECT_NAME="Jobnity API"
API_V1_STR="/api"
SECRET_KEY="jobnity_dev_secret_key_change_in_production"

# Database (SQLAlchemy format. Defaults to SQLite file in backend/jobnity.db if PostgreSQL URL is not set)
DATABASE_URL="sqlite:///./jobnity.db"

# Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Settings (Comma separated list)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
