#!/usr/bin/zsh
# ==============================================================================
# JOBNITY CLI - Career Readiness & Skill Gap Analysis Platform Launcher
# ==============================================================================
# Single Zsh script to start, stop, monitor, and view logs for Jobnity.
# Can be run from anywhere in the terminal.
# ==============================================================================

JOBNITY_DIR="/home/adityap/ai/Projects/Jobnity"
STATE_DIR="$HOME/.jobnity"
PID_BACKEND="$STATE_DIR/backend.pid"
PID_FRONTEND="$STATE_DIR/frontend.pid"
LOG_BACKEND="$STATE_DIR/backend.log"
LOG_FRONTEND="$STATE_DIR/frontend.log"
BACKEND_PORT=8001
FRONTEND_PORT=5173

# Color definitions
CLR_BOLD="\033[1m"
CLR_GREEN="\033[0;32m"
CLR_CYAN="\033[0;36m"
CLR_YELLOW="\033[1;33m"
CLR_RED="\033[0;31m"
CLR_RESET="\033[0m"

# Ensure runtime directories exist
mkdir -p "$STATE_DIR"

is_pid_running() {
  local pid=$1
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  else
    return 1
  fi
}

get_backend_pid() {
  local pid=""
  if [[ -f "$PID_BACKEND" ]]; then
    pid=$(cat "$PID_BACKEND" 2>/dev/null)
    if is_pid_running "$pid"; then
      echo "$pid"
      return 0
    fi
  fi
  pid=$(lsof -ti :"$BACKEND_PORT" 2>/dev/null | head -1)
  if [[ -n "$pid" ]]; then
    echo "$pid" > "$PID_BACKEND"
    echo "$pid"
    return 0
  fi
  return 1
}

get_frontend_pid() {
  local pid=""
  if [[ -f "$PID_FRONTEND" ]]; then
    pid=$(cat "$PID_FRONTEND" 2>/dev/null)
    if is_pid_running "$pid"; then
      echo "$pid"
      return 0
    fi
  fi
  pid=$(lsof -ti :"$FRONTEND_PORT" 2>/dev/null | head -1)
  if [[ -n "$pid" ]]; then
    echo "$pid" > "$PID_FRONTEND"
    echo "$pid"
    return 0
  fi
  return 1
}

start_services() {
  echo "${CLR_BOLD}${CLR_CYAN}🚀 Starting Jobnity Platform...${CLR_RESET}"

  # 1. Start Backend FastAPI
  local b_pid=$(get_backend_pid)
  if [[ -n "$b_pid" ]]; then
    echo "  ${CLR_YELLOW}• Backend already running (PID: $b_pid, Port: $BACKEND_PORT)${CLR_RESET}"
  else
    echo -n "  • Starting Backend (FastAPI on port $BACKEND_PORT)... "
    cd "$JOBNITY_DIR/backend" || { echo "${CLR_RED}Failed to cd to backend!${CLR_RESET}"; exit 1; }
    setsid python3 -m uvicorn app.main:app --host 0.0.0.0 --port "$BACKEND_PORT" > "$LOG_BACKEND" 2>&1 &
    
    local new_b_pid=""
    for i in {1..16}; do
      sleep 0.5
      new_b_pid=$(get_backend_pid)
      if [[ -n "$new_b_pid" ]]; then
        break
      fi
    done

    if [[ -n "$new_b_pid" ]]; then
      echo "$new_b_pid" > "$PID_BACKEND"
      echo "${CLR_GREEN}Started (PID: $new_b_pid)${CLR_RESET}"
    else
      echo "${CLR_RED}Failed to start. Check $LOG_BACKEND${CLR_RESET}"
    fi
  fi

  # 2. Start Frontend Vite
  local f_pid=$(get_frontend_pid)
  if [[ -n "$f_pid" ]]; then
    echo "  ${CLR_YELLOW}• Frontend already running (PID: $f_pid, Port: $FRONTEND_PORT)${CLR_RESET}"
  else
    echo -n "  • Starting Frontend (Vite on port $FRONTEND_PORT)... "
    cd "$JOBNITY_DIR" || { echo "${CLR_RED}Failed to cd to project root!${CLR_RESET}"; exit 1; }
    setsid npm run dev -- --port "$FRONTEND_PORT" > "$LOG_FRONTEND" 2>&1 &
    
    local new_f_pid=""
    for i in {1..12}; do
      sleep 0.5
      new_f_pid=$(get_frontend_pid)
      if [[ -n "$new_f_pid" ]]; then
        break
      fi
    done

    if [[ -n "$new_f_pid" ]]; then
      echo "$new_f_pid" > "$PID_FRONTEND"
      echo "${CLR_GREEN}Started (PID: $new_f_pid)${CLR_RESET}"
    else
      echo "${CLR_RED}Failed to start. Check $LOG_FRONTEND${CLR_RESET}"
    fi
  fi

  echo ""
  echo "${CLR_BOLD}${CLR_GREEN}=====================================================${CLR_RESET}"
  echo "${CLR_BOLD}${CLR_GREEN}       ✨ JOBNITY IS READY AND RUNNING LOCALLY!       ${CLR_RESET}"
  echo "${CLR_BOLD}${CLR_GREEN}=====================================================${CLR_RESET}"
  echo "  ${CLR_BOLD}App Web UI:${CLR_RESET}   ${CLR_CYAN}http://localhost:$FRONTEND_PORT${CLR_RESET}"
  echo "  ${CLR_BOLD}Backend API:${CLR_RESET}  ${CLR_CYAN}http://localhost:$BACKEND_PORT/api${CLR_RESET}"
  echo "  ${CLR_BOLD}API Docs:${CLR_RESET}     ${CLR_CYAN}http://localhost:$BACKEND_PORT/docs${CLR_RESET}"
  echo "  ${CLR_BOLD}Logs Dir:${CLR_RESET}     $STATE_DIR/"
  echo "${CLR_BOLD}${CLR_GREEN}=====================================================${CLR_RESET}"
  echo "Use ${CLR_BOLD}jobnity status${CLR_RESET} to inspect status or ${CLR_BOLD}jobnity stop${CLR_RESET} to shut down."
}

stop_services() {
  echo "${CLR_BOLD}${CLR_YELLOW}🛑 Stopping Jobnity Platform...${CLR_RESET}"

  local b_pid=$(get_backend_pid)
  if [[ -n "$b_pid" ]]; then
    echo -n "  • Terminating Backend (PID: $b_pid)... "
    kill "$b_pid" 2>/dev/null
    sleep 1
    if is_pid_running "$b_pid"; then
      kill -9 "$b_pid" 2>/dev/null
    fi
    rm -f "$PID_BACKEND"
    echo "${CLR_GREEN}Stopped${CLR_RESET}"
  else
    echo "  • Backend is not running."
    rm -f "$PID_BACKEND"
  fi

  local f_pid=$(get_frontend_pid)
  if [[ -n "$f_pid" ]]; then
    echo -n "  • Terminating Frontend (PID: $f_pid)... "
    kill "$f_pid" 2>/dev/null
    sleep 1
    if is_pid_running "$f_pid"; then
      kill -9 "$f_pid" 2>/dev/null
    fi
    rm -f "$PID_FRONTEND"
    echo "${CLR_GREEN}Stopped${CLR_RESET}"
  else
    echo "  • Frontend is not running."
    rm -f "$PID_FRONTEND"
  fi

  # Cleanup any lingering processes on backend & frontend ports
  local leftover_b=$(lsof -ti :"$BACKEND_PORT" 2>/dev/null)
  if [[ -n "$leftover_b" ]]; then
    kill -9 $leftover_b 2>/dev/null
  fi

  local leftover_f=$(lsof -ti :"$FRONTEND_PORT" 2>/dev/null)
  if [[ -n "$leftover_f" ]]; then
    kill -9 $leftover_f 2>/dev/null
  fi

  echo "${CLR_BOLD}${CLR_GREEN}Jobnity services stopped successfully.${CLR_RESET}"
}

status_services() {
  echo "${CLR_BOLD}${CLR_CYAN}📊 Jobnity Service Status${CLR_RESET}"
  echo "-----------------------------------------------------"

  local b_pid=$(get_backend_pid)
  if [[ -n "$b_pid" ]]; then
    local health=$(curl -s "http://localhost:$BACKEND_PORT/api/health" 2>/dev/null)
    if [[ "$health" =~ "\"status\":\"ok\"" || "$health" =~ "ok" ]]; then
      echo "  ${CLR_BOLD}Backend:${CLR_RESET}  ${CLR_GREEN}RUNNING${CLR_RESET} (PID: $b_pid, Port: $BACKEND_PORT, Health: OK)"
    else
      echo "  ${CLR_BOLD}Backend:${CLR_RESET}  ${CLR_YELLOW}STARTING / UNRESPONSIVE${CLR_RESET} (PID: $b_pid, Port: $BACKEND_PORT)"
    fi
  else
    echo "  ${CLR_BOLD}Backend:${CLR_RESET}  ${CLR_RED}STOPPED${CLR_RESET}"
  fi

  local f_pid=$(get_frontend_pid)
  if [[ -n "$f_pid" ]]; then
    echo "  ${CLR_BOLD}Frontend:${CLR_RESET} ${CLR_GREEN}RUNNING${CLR_RESET} (PID: $f_pid, Port: $FRONTEND_PORT)"
  else
    echo "  ${CLR_BOLD}Frontend:${CLR_RESET} ${CLR_RED}STOPPED${CLR_RESET}"
  fi

  echo "-----------------------------------------------------"
  echo "  Web UI:   http://localhost:$FRONTEND_PORT"
  echo "  API Docs: http://localhost:$BACKEND_PORT/docs"
}

logs_services() {
  local target="${1:-all}"
  case "$target" in
    backend|b)
      echo "${CLR_BOLD}${CLR_CYAN}Showing Backend Logs ($LOG_BACKEND):${CLR_RESET}"
      tail -f -n 50 "$LOG_BACKEND"
      ;;
    frontend|f)
      echo "${CLR_BOLD}${CLR_CYAN}Showing Frontend Logs ($LOG_FRONTEND):${CLR_RESET}"
      tail -f -n 50 "$LOG_FRONTEND"
      ;;
    all|*)
      echo "${CLR_BOLD}${CLR_CYAN}Showing Combined Logs (Press Ctrl+C to exit):${CLR_RESET}"
      tail -f -n 30 "$LOG_BACKEND" "$LOG_FRONTEND"
      ;;
  esac
}

show_help() {
  echo "${CLR_BOLD}${CLR_CYAN}JOBNITY CLI - Usage Guide${CLR_RESET}"
  echo ""
  echo "Usage: ${CLR_BOLD}jobnity${CLR_RESET} [command]"
  echo ""
  echo "Commands:"
  echo "  ${CLR_BOLD}start${CLR_RESET}           Start Jobnity backend and frontend services (default)"
  echo "  ${CLR_BOLD}stop${CLR_RESET}            Stop all Jobnity background processes"
  echo "  ${CLR_BOLD}restart${CLR_RESET}         Restart backend and frontend services"
  echo "  ${CLR_BOLD}status${CLR_RESET}          Check running status of Jobnity services"
  echo "  ${CLR_BOLD}logs [b|f|all]${CLR_RESET}  Tail logs (b=backend, f=frontend, default=all)"
  echo "  ${CLR_BOLD}help, -h${CLR_RESET}        Show this help message"
  echo ""
  echo "Examples:"
  echo "  $ jobnity"
  echo "  $ jobnity start"
  echo "  $ jobnity status"
  echo "  $ jobnity stop"
}

# Subcommand Router
case "${1:-start}" in
  start)
    start_services
    ;;
  stop)
    stop_services
    ;;
  restart)
    stop_services
    sleep 1
    start_services
    ;;
  status)
    status_services
    ;;
  logs)
    logs_services "$2"
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo "${CLR_RED}Unknown command: $1${CLR_RESET}"
    echo ""
    show_help
    exit 1
    ;;
esac
